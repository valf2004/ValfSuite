# Invio delle richieste di disponibilità. Lasciare vuoto finché non viene scelto il servizio.
AVAILABILITY_WEBHOOK_URL=

# Database PostgreSQL interno alla rete Docker.
POSTGRES_PASSWORD=

# Invio SMTP dalla VM. Usare una password per le app, mai la password dell'account Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=valfsuite@gmail.com
SMTP_APP_PASSWORD=
EMAIL_RECIPIENTS=valfsuite@gmail.com,viliorlandi@gmail.com,angrimaldi@gmail.com,valf2004@gmail.com

# Google OAuth per l'area riservata.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://valfsuite.valfservice.it/api/auth/google/callback

# Generare una stringa casuale di almeno 32 caratteri. Non riutilizzare password personali.
AUTH_SESSION_SECRET=

# Elenco separato da virgole degli account ammessi.
AUTHORIZED_ADMIN_EMAILS=valfsuite@gmail.com,viliorlandi@gmail.com,angrimaldi@gmail.com,valf2004@gmail.com
